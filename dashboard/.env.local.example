# Where the dashboard reads from.
#
# This is the live Railway deployment — the same value Vercel needs as an environment
# variable (Project -> Settings -> Environment Variables -> NEXT_PUBLIC_API_URL).
#
# For local development against a local API instead, copy this to .env.local and set:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# That is also what the dashboard falls back to when the variable is unset entirely.
NEXT_PUBLIC_API_URL=https://triage-api-production-00b4.up.railway.app

# TRIAGE API configuration. Every value is optional; the defaults are the local
# development behaviour, so nothing in the test suite needs this file.

# Refuse every write. A deployed instance serves pre-computed runs and must never
# mutate them — enforced by a route dependency AND by opening SQLite mode=ro.
TRIAGE_READ_ONLY=false

# The working store. Created on demand when not read-only.
# TRIAGE_DB_PATH=./triage.db

# Where pre-computed evaluation runs live. The dashboard's Results screen reads these.
# TRIAGE_DB_DIR=./eval/runs

# Comma-separated allowed origins. Defaults to "*" locally; set explicitly in production.
# TRIAGE_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Seed for the world the API resolves attempts against.
# TRIAGE_SIM_SEED=42
